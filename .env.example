# Copy to .env for local runs, or set these as environment variables on your host.

# Where the LexCrawl API lives, and its bearer token (kept server-side; never sent to browsers).
LEXCRAWL_API_URL=http://localhost:8000
LEXCRAWL_API_TOKEN=

# Seconds to wait for the API (free hosts can take ~20 s to wake a sleeping container).
API_TIMEOUT_SECONDS=30

# Seconds to reuse API responses across page views (0 disables caching).
CACHE_TTL_SECONDS=60

# Branding.
SITE_TITLE=Lexcrawl-Dashboard
SITE_TAGLINE=Legal & regulatory updates, as they are crawled

# Port the server listens on (most hosts set PORT for you).
PORT=8080
